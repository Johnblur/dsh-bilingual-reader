# This plugin depends on DSH-provided peer packages (dsh-better-sidebar,
# @deepseek-ai/dsh-llm, @deepseek-ai/dsh-client-runtime, cordis) which are NOT
# fetched from npm at install time — the running DSH provides them. So:
#   - do NOT auto-install peer deps from the registry
#   - do NOT fail if a peer is missing (it is satisfied by DSH at runtime)
auto-install-peers=false
strict-peer-dependencies=false

# Be resilient to slow mirrors (the UND_ERR_DESTROYED retries you saw).
fetch-retries=5
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
